[Desktop Entry]
Name=Install DeckStore
Comment=One-Click Installer for DeckStore (installs and adds to Steam)
Exec=bash -c "curl -sSL https://github.com/liberavia/deck-store/releases/latest/download/install.sh | bash"
Icon=system-software-install
Terminal=false
Type=Application
Categories=Utility;Game;
StartupNotify=true

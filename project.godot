; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="DeckStore"
run/main_scene="uid://bl8qcy5u1yua6"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
config/icon="res://assets/graphics/icon.svg"

[autoload]

OnlineStatusManager="*res://scripts/OnlineStatusManager.gd"
AppBlacklist="*res://scripts/AppBlacklist.gd"
DownloadManager="*res://scripts/DownloadManager.gd"
SteamIntegration="*res://scripts/SteamIntegration.gd"
GlobalBackgroundShader="*res://shaders/global_background_shader.tscn"
OdrsRatingsCache="*res://scripts/OdrsRatingsCache.gd"
ExtensionsManager="*res://scripts/ExtensionsManager.gd"
ControllerManager="*res://scripts/ControllerManager.gd"
SettingsManager="*res://scripts/SettingsManager.gd"
SystemUtils="*res://scripts/SystemUtils.gd"
SelfUpdateManager="*res://scripts/SelfUpdateManager.gd"

[debug]

file_logging/enable_file_logging=true
file_logging/log_path="user://logs/deck-store.log"

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/per_pixel_transparency/allowed=true

[editor]

version_control/plugin_name="GitPlugin"
version_control/autoload_on_startup=true

[editor_plugins]

enabled=PackedStringArray("res://addons/godotsteam/plugin.cfg", "res://addons/gut/plugin.cfg")

